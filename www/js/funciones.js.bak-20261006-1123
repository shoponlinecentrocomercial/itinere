function ponBounds() {
//Forzar zoom al maximo
// 1. Obtener todos los puntos (coordenadas) de la polilínea
var latlngs = polyline.getLatLngs();

// 2. Comprobar que hay al menos 2 puntos para evitar errores
if (latlngs.length >= 2) {
    
    // 3. Extraer solo los dos últimos puntos
    var lastTwoPoints = [
        latlngs[latlngs.length - 2], // Penúltimo punto
        latlngs[latlngs.length - 1]  // Último punto
    ];

    // 4. Crear un nuevo objeto de límites (Bounds) solo con esos dos puntos
    var lastTwoBounds = L.latLngBounds(lastTwoPoints);

    // 5. Ajustar el mapa aplicando el padding que tenías
    mymap.fitBounds(lastTwoBounds.pad(0.25));
    
} else if (latlngs.length === 1) {
    // Opcional: si solo hay un punto, simplemente centra el mapa en él
    mymap.setView(latlngs[0], 15); // 15 es el nivel de zoom
}
}