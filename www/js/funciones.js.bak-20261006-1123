var video  = document.getElementById('video');
var stream = video ? video.srcObject : null;
var canvas = document.getElementById('canvas');
var ctx    = canvas ? canvas.getContext('2d') : null;
function verFoto() {
    video = document.getElementById('video');
    stream = video.srcObject;
    canvas = document.getElementById('canvas');
    ctx = canvas.getContext('2d');

	if (document.getElementById('divFoto').style.display=='none') {
    	document.getElementById('divFoto').style.display='inline';
	    // Acceder a la cámara
        navigator.mediaDevices.getUserMedia( { video: { facingMode: "environment" , width: 1280, height: 720 }  })
        .then(stream => {
            video.srcObject = stream;
            video.play();
         });
     } else {
     	if (document.getElementById('comentarFoto').style.display=='none') {
              if (stream && typeof stream.getTracks === 'function') {
                  stream.getTracks().forEach(track => {
                       track.stop();
                  });
              }   
              video.srcObject=null;
              document.getElementById('divFoto').style.display='none';
         } else {
         	document.getElementById('comentarFoto').style.display='none';
             document.getElementById('tomarFoto').style.display='inline-block';
             navigator.mediaDevices.getUserMedia( { video: { facingMode: "environment" , width: 1280, height: 720 }  })
             .then(stream => {
                 video.srcObject = stream;
                 video.play();
              });
         }
     }
}


