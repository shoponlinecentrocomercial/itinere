    const factorCV = 735.49875; // 1 CV = 735.49875 W (J/s)
    var caballos=joulesPerSecond / factorCV;
    if (!isNaN(caballos)) {
         if (caballos > 999) {
             var kcab = caballos / 1000;
             return kcab.toFixed(2) + " Kcv";
         } else {
              return caballos.toFixed(2);
         }
    } else {
    	return "0.00";
    }
}
function dibujarGrafica() {
    try {
        if (typeof geoson === 'undefined') {
            throw new Error("No se pudo leer la variable 'geoson' del archivo");
        }

        let tipoGrafica = document.getElementById('graph').value;
        if (!['altura', 'velocidad', 'altvel'].includes(tipoGrafica)) return;

        let datosParaGrafica =[];
        let distanciaAcumulada = 0;
        let prevLat = null;
        let prevLon = null;

        // 1. Configuramos las cabeceras según la opción seleccionada
        if (tipoGrafica === 'altura') {
            datosParaGrafica.push(['Distancia (km)', 'Elevación (m)']);
        } else if (tipoGrafica === 'velocidad') {
            datosParaGrafica.push(['Distancia (km)', 'Velocidad (km/h)']);
        } else if (tipoGrafica === 'altvel') {
            datosParaGrafica.push(['Distancia (km)', 'Elevación (m)', 'Velocidad (km/h)']);
        }

        // 2. Procesar los puntos UNA sola vez de forma limpia
        for (let i = 0; i < geoson.length; i++) {
            // parseFloat obliga a que sea un número. String() evita errores si el dato viene nulo/undefined
            let lon = parseFloat(String(geoson[i][0]).replace("[", ""));
            let lat = parseFloat(geoson[i][1]);
            let elevacion = geoson[i][2] !== undefined ? parseFloat(geoson[i][2]) : 0;
            let velocidad = geoson[i][3] !== undefined ? parseFloat(String(geoson[i][3]).replace("]", "")) : 0;

            // 3. Calculamos la distancia usando los prev limpios
            if (prevLat !== null && prevLon !== null) {
                distanciaAcumulada += calcularDistancia(prevLat, prevLon, lat, lon);
            }

            let distRedondeada = Math.round(distanciaAcumulada * 100) / 100;

            // 4. Metemos los datos numéricos en el array de Google Charts
            if (tipoGrafica === 'altura') {
                datosParaGrafica.push([distRedondeada, elevacion]);
            } else if (tipoGrafica === 'velocidad') {
                datosParaGrafica.push([distRedondeada, velocidad]);
            } else if (tipoGrafica === 'altvel') {
                datosParaGrafica.push([distRedondeada, elevacion, velocidad]);
            }

            // 5. Guardamos las coordenadas limpias para la siguiente vuelta (Esto evita el error del corchete)
            prevLat = lat;
            prevLon = lon;
        }

        var data = google.visualization.arrayToDataTable(datosParaGrafica);
        var options = {};

        // 6. Opciones visuales
        if (tipoGrafica === 'altura') {
            options = {
                title: '', curveType: 'function', legend: { position: 'bottom' },
                vAxis: { title: 'Altura (m)', titleTextStyle: { color: '#ffffff' }, textStyle: { color: '#ffffff' } },
                hAxis: { title: 'Distancia (km)', titleTextStyle: { color: '#ffffff' } },
                colors: ['orange'], areaOpacity: 0.5,
                backgroundColor: { fill: '#F7B64D', fillOpacity: 0.5 }
            };
        } else if (tipoGrafica === 'velocidad') {
            options = {
                title: '', curveType: 'function', legend: { position: 'bottom' },
                vAxis: { title: 'Velocidad (km/h)', titleTextStyle: { color: '#ffffff' }, textStyle: { color: '#ffffff' } },
                hAxis: { title: 'Distancia (km)', titleTextStyle: { color: '#ffffff' } },
                colors: ['#FC5F3A'], areaOpacity: 0.5,
                backgroundColor: { fill: '#F7B64D', fillOpacity: 0.5 }
            };
        } else if (tipoGrafica === 'altvel') {
            options = {
                title: '', curveType: 'function', legend: { position: 'bottom' },
                vAxis: { title: 'Elevación (m) & Velocidad (km/h)', titleTextStyle: { color: '#ffffff' }, textStyle: { color: '#ffffff' } },
                hAxis: { title: 'Distancia (km)', titleTextStyle: { color: '#ffffff' } },
                colors: ['orange', '#FC5F3A'], areaOpacity: 0.5,
                backgroundColor: { fill: '#F7B64D', fillOpacity: 0.5 }
            };
        }

        // 7. Dibujar la gráfica
        var chart = new google.visualization.AreaChart(document.getElementById('mychart'));
        chart.draw(data, options);

    } catch (error) {
        console.error(error);
        document.getElementById('mychart').innerHTML = "<b>Error al generar la gráfica:</b> " + error.message;
    }

    // Función Haversine para calcular distancia real en KM
    function calcularDistancia(lat1, lon1, lat2, lon2) {
        const R = 6371;
        const dLat = (lat2 - lat1) * Math.PI / 180;
        const dLon = (lon2 - lon1) * Math.PI / 180;
        const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
            Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
            Math.sin(dLon / 2) * Math.sin(dLon / 2);
        const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
        return R * c;
    }
}

