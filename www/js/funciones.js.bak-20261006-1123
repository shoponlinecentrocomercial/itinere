      document.getElementById('home').style.opacity=".3";
  } else {
      document.getElementById('home').style.opacity="1";
  }
  segundos++;
  seg=document.getElementById('segundos').innerHTML;
  minu=document.getElementById('minutos').innerHTML;
  hor=document.getElementById('horas').innerHTML;
  seg=parseInt(seg);
  minu=parseInt(minu);
  hor=parseInt(hor);
  seg++;
  if (seg>59) {
      minu++;
      seg=0;
      if (minu>59) {        
          hor++;
          minu=0;
       }
   }
   if (seg<10) {
     document.getElementById('segundos').innerHTML='0'+seg;
   } else {
     document.getElementById('segundos').innerHTML=seg;
   }
   if (minu<10) {
     document.getElementById('minutos').innerHTML='0'+minu;
   } else {
     document.getElementById('minutos').innerHTML=minu;
   }
    if (hor<10) {
     document.getElementById('horas').innerHTML='0'+hor;
   } else {
     document.getElementById('horas').innerHTML=hor;
   }
   if (parada==false) {
       marcha = segundos - paros;
       var secs=0;
       var mins=0;
       var hors=0;
       if (marcha>59) {
             mins=parseInt(marcha / 60);
             secs=marcha-(mins*60);
        } else {
             secs=marcha;
        }
        if (mins > 59) {
             hors=parseInt(mins / 60);
             mins=mins-(hors*60);
        }
        if (secs<10)  { secs='0'+secs; }
        if (mins<10)  { mins='0'+mins; }
        if (hors<10)  { hors='0'+hors; }
        document.getElementById('marcha').innerHTML = hors+":"+mins+":"+secs;
    } else {
        paros = segundos - marcha;
        var secs=0;
        var mins=0;
        var hors=0;
         if (paros>59) {
               mins=parseInt(paros / 60);
               secs=paros-(mins*60);
          } else {
                secs=paros;
          }
          if (mins > 59) {
                hors=parseInt(mins / 60);
                mins=mins-(hors*60);
          }
          if (secs<10)  { secs='0'+secs; }
          if (mins<10)  { mins='0'+mins; }
          if (hors<10)  { hors='0'+hors; }
          document.getElementById('descanso').innerHTML = hors+":"+mins+":"+secs;
    }
}
// --- FUNCIONES PARA ENSAMBLAR Y LIMPIAR DATOS TEMPORALES ---
async function prepararGeosonFinal() {
    return new Promise((resolve) => {
        if (!dbTemp) {
            resolve(geoson); // Si no hay Base de Datos, mandamos lo que haya en la variable RAM
            return;
        }
        
        let tx = dbTemp.transaction("geosonChunks", "readonly");
        let request = tx.objectStore("geosonChunks").getAll();

        request.onsuccess = function() {
            let chunksGuardados = request.result; // Array con los bloques de 1000 puntos
            let geosonCompleto =[];
            
            // Juntamos todos los bloques guardados en el disco duro
            chunksGuardados.forEach(chunk => {
                geosonCompleto = geosonCompleto.concat(chunk);
            });
            
            // Añadimos el último pico de puntos que quedó en la RAM (los que no llegaron a 1000)
            geosonCompleto = geosonCompleto.concat(geoson);
            
            resolve(geosonCompleto);
        };
        
        request.onerror = function() {
            console.error("No se pudo leer la IndexedDB temporal.");
            resolve(geoson); // Si falla, intentamos salvar al menos la RAM
        };
    });
}

function limpiarBaseDeDatosTemporal() {
    if (!dbTemp) return;
    let tx = dbTemp.transaction("geosonChunks", "readwrite");
    tx.objectStore("geosonChunks").clear();
    console.log("Copia de seguridad temporal eliminada.");
}
