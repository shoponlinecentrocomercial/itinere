function energia(masa, desnivelPositivo) {
    const g = 9.81; // m/s²
    const energiaJoules = masa * g * desnivelPositivo;
    return energiaJoules;
}
function potencia(joules) {
   var kw = joules / 3600;
   if (kw > 999) {
        var mw = kw / 1000;
        return mw.toFixed(2) + " Mw";
    } else {
         return kw.toFixed(2);
    }
}   
function calcularEnergiaPlano({
  masa,
  distancia,
  velocidad,
  coefRozamiento = 0.01,
  coefAerodinamico = 0.9,
  areaFrontal = 0.5,
  densidadAire = 1.225
  }) {
  const g = 9.81;
  const F_rodadura = coefRozamiento * masa * g;
  const F_aire = 0.5 * coefAerodinamico * areaFrontal * densidadAire * velocidad ** 2;
  const F_total = F_rodadura + F_aire;
  return F_total * distancia;
}
