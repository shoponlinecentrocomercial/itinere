function cambioLinea() {
    polyline.remove();
    var modo = document.getElementById('linea').value;

    if (modo == 'distancia') {
        polyline = L.multiOptionsPolyline(coordenadas, {
            multiOptions: {
                optionIdxFn: function (latLng, prevLatLng, index) {
                    return Math.min(index, degradado.length - 1);
                },
                options: degradado
            },
            weight: 6,
            opacity: 0.8,
            smoothFactor: 1
        }).addTo(mymap);
        return;
    }

    if (modo == 'velocidad') {
        var pVelocidad = velmax / degradado.length;
        var velocidades = [];
        for (var v = 0; v < degradado.length; v++) {
            velocidades.push(pVelocidad * v);
        }
        polyline = L.multiOptionsPolyline(coordenadas, {
            multiOptions: {
                optionIdxFn: function (latLng, prevLatLng, index) {
                    if (!isFinite(pVelocidad) || pVelocidad === 0) return 0;
                    if (!geoson[index] || geoson[index][3] === undefined) return 0;
                    var vel = parseFloat(String(geoson[index][3]).replace("]", ""));
                    for (var i = 0; i < velocidades.length; i++) {
                        if (vel <= velocidades[i]) return i;
                    }
                    return velocidades.length - 1;
                },
                options: degradado
            },
            weight: 6,
            opacity: 0.8,
            smoothFactor: 1
        }).addTo(mymap);
        return;
    }

    if (modo == 'altura') {
        var pAltura = desnivel / degradado.length;
        var alturas = [];
        for (var a = 0; a < degradado.length; a++) {
            alturas.push(pAltura * a);
        }
        polyline = L.multiOptionsPolyline(coordenadas, {
            multiOptions: {
                optionIdxFn: function (latLng, prevLatLng, index) {
                    if (!isFinite(pAltura) || pAltura === 0) return 0;
                    if (!geoson[index] || geoson[index][2] === undefined) return 0;
                    var alt = parseFloat(String(geoson[index][2]));
                    var diff = alturaMax - alt; // 0 = pico; valor mayor = valle
                    for (var i = 0; i < alturas.length; i++) {
                        if (diff <= alturas[i]) return i;
                    }
                    return alturas.length - 1;
                },
                options: degradado
            },
            weight: 6,
            opacity: 0.8,
            smoothFactor: 1
        }).addTo(mymap);
    }
}
