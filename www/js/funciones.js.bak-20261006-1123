function modificarCadena(str) {
  str.replaceAll('ç','s');
  str.replaceAll('ñ','n');
  str.replaceAll('-','');
  str.replaceAll('#','');
  str.replaceAll('@','');
  return str;
}
function generarSeoURL(titulo) {
    // Convertir a minúsculas y sanitizar con htmlspecialchars equivalente
    let sanitizada = titulo.toLowerCase();
    // Validar que el título no esté vacío
    if (!sanitizada || sanitizada.trim() === '') {
        throw new Error('Título inválido.');
    }
    // Reemplazar caracteres no alfanuméricos por guiones
    let urlSEO = sanitizada.replace(/[^a-z0-9]+/g, '-');
    // Eliminar guiones duplicados y los que están al inicio o final
    return urlSEO.replace(/-+/g, '-').replace(/^-+|-+$/g, '');
}   
function activarPantallaCompleta(elemento) {
  if (elemento.requestFullscreen) {
