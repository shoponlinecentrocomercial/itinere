/*
 * Itinere — reset minimal + utilities.
 * Carga DESPUÉS de tokens.css.
 */

*, *::before, *::after { box-sizing: border-box; }

html {
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
    font-size: var(--fs-md);
    line-height: var(--lh-normal);
}

body {
    margin: 0;
    min-height: 100dvh;
    font-family: var(--font-sans);
    color: var(--c-ink);
    background: var(--c-canvas);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    overscroll-behavior-y: contain;
}

img, svg, video, canvas { display: block; max-width: 100%; }

h1, h2, h3, h4 {
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    line-height: var(--lh-tight);
    margin: 0 0 var(--sp-3);
}

h1 { font-size: var(--fs-2xl); letter-spacing: -.02em; }
h2 { font-size: var(--fs-xl); letter-spacing: -.01em; }
h3 { font-size: var(--fs-lg); }
h4 { font-size: var(--fs-md); }

p { margin: 0 0 var(--sp-3); color: var(--c-ink-soft); }

a {
    color: var(--c-primary);
    text-decoration: none;
    transition: color var(--t-quick);
}
a:hover { color: var(--c-primary-hover); }
a:focus-visible { outline: 2px solid var(--c-primary); outline-offset: 2px; border-radius: 2px; }

button, input, select, textarea {
    font: inherit;
    color: inherit;
}

button { cursor: pointer; background: none; border: 0; padding: 0; }

input, textarea, select {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--r-md);
    padding: var(--sp-3) var(--sp-4);
    transition: border-color var(--t-quick), box-shadow var(--t-quick);
    width: 100%;
}
input:focus-visible,
textarea:focus-visible,
select:focus-visible {
    outline: 0;
    border-color: var(--c-primary);
    box-shadow: 0 0 0 4px var(--c-primary-bg);
}

::placeholder { color: var(--c-ink-muted); opacity: 1; }

/* ============ Utilities ============ */

.container {
    width: 100%;
    max-width: var(--max-w);
    margin-inline: auto;
    padding-inline: var(--sp-4);
}

.stack    { display: flex; flex-direction: column; }
.row      { display: flex; flex-direction: row; }
.row-wrap { display: flex; flex-wrap: wrap; }
.center   { display: flex; align-items: center; justify-content: center; }
.between  { display: flex; align-items: center; justify-content: space-between; }
.gap-1 { gap: var(--sp-1); } .gap-2 { gap: var(--sp-2); }
.gap-3 { gap: var(--sp-3); } .gap-4 { gap: var(--sp-4); } .gap-5 { gap: var(--sp-5); }

.pt-4 { padding-top: var(--sp-4); }    .pb-4 { padding-bottom: var(--sp-4); }
.mt-4 { margin-top: var(--sp-4); }     .mb-4 { margin-bottom: var(--sp-4); }
.mt-5 { margin-top: var(--sp-5); }     .mb-5 { margin-bottom: var(--sp-5); }

.text-xs  { font-size: var(--fs-xs); }
.text-sm  { font-size: var(--fs-sm); }
.text-lg  { font-size: var(--fs-lg); }
.text-xl  { font-size: var(--fs-xl); }
.text-2xl { font-size: var(--fs-2xl); }
.text-num { font-family: var(--font-display); font-weight: var(--fw-bold); font-variant-numeric: tabular-nums; }

.muted    { color: var(--c-ink-muted); }
.soft     { color: var(--c-ink-soft); }

.hidden   { display: none !important; }
.visually-hidden {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
}

/* Página con tab bar deja espacio inferior para no quedar tapada */
.with-tabbar {
    padding-bottom: calc(var(--tabbar-h) + var(--safe-bottom) + var(--sp-4));
}
