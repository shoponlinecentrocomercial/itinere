# Variables de entorno de ejemplo para Itinere
# Copia este archivo a .env y rellena los valores reales antes de arrancar la app.

# API de Mapbox
MAPBOX_TOKEN=your_mapbox_token_here

# Firma de cookies y autenticación
COOKIE_SECRET=change_this_to_a_long_random_secret

# Base de datos MySQL
DB_HOST=localhost
DB_USER=itinere_user
DB_PASSWORD=your_db_password_here
DB_NAME=itinere

# Certificados SSL para HTTPS
SSL_KEY_PATH=/path/to/your/private-key.pem
SSL_CERT_PATH=/path/to/your/certificate.pem

# Directorio donde se sirven uploads y contenido estático
UPLOADS_DIR=/var/www/itinere.pro

# CORS y autenticación WebAuthn
CORS_ORIGINS=https://itinere.pro
WEBAUTHN_RP_ID=itinere.pro
WEBAUTHN_RP_NAME=Itinere

# Puerto HTTPS del backend
NODE_HTTPS_PORT=8443

# Resend / email webhook
RESEND_API_KEY=your_resend_api_key_here
SECRET_RESEND=your_resend_webhook_secret_here

# Límites de uso de Mapbox por día
MAPBOX_MAX_STATIC=6000
MAPBOX_MAX_RASTER=22000
MAPBOX_MAX_QUERY=3000
