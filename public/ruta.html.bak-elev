<!DOCTYPE html>
<html lang="es">
<head>
<script>
// URL esperada: /ruta/{slug}/{id}/{lat_ini}/{lon_ini}/{distancia_total}
var id = 0;
var _u = location.href;
const dis   = _u.substring(_u.lastIndexOf("/") + 1); _u = _u.substring(0, _u.lastIndexOf("/"));
const lonIni= _u.substring(_u.lastIndexOf("/") + 1); _u = _u.substring(0, _u.lastIndexOf("/"));
const latIni= _u.substring(_u.lastIndexOf("/") + 1); _u = _u.substring(0, _u.lastIndexOf("/"));
const ruta  = _u.substring(_u.lastIndexOf("/") + 1);

fetch('/read-cookie', { credentials: 'include' })
    .then(r => r.json())
    .then(d => {
        if (!d.logueado) {
            window.location.href = '/acceso.html?pag=/ruta|' + ruta + '|' + latIni + '|' + lonIni + '|' + dis;
        } else {
            id = d.id;
        }
    })
    .catch(err => console.error('read-cookie:', err));
</script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <meta name="theme-color" content="#FFF8F0" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#14172A" media="(prefers-color-scheme: dark)">
    <meta http-equiv="Content-Security-Policy" content="default-src 'self' https://itinere.pro https://itinere.pro:2083; connect-src 'self' https://itinere.pro https://itinere.pro:2083 wss://itinere.pro:2083; script-src 'self' 'unsafe-inline' https://itinere.pro; style-src 'self' 'unsafe-inline' https://itinere.pro; img-src 'self' data: blob: https:; media-src 'self' blob: https://itinere.pro; font-src 'self' data:; frame-src https://itinere.pro:2083; object-src 'none';">

    <title data-i18n="meta.title.ruta">Recorrer ruta — Itinere</title>

    <link rel="icon" href="/img/logo.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/img/generated/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">

    <link rel="stylesheet" href="https://itinere.pro/css/tokens.css">
    <link rel="stylesheet" href="https://itinere.pro/css/base.css">
    <link rel="stylesheet" href="https://itinere.pro/css/components.css">
    <link rel="stylesheet" href="https://itinere.pro/css/leaflet-1-6-0.css">
    <link rel="stylesheet" href="https://itinere.pro/css/leaflet-elevation.css">
    <link rel="stylesheet" href="https://itinere.pro/css/estilos.css">

    <script src="https://itinere.pro/js/leaflet-1-6-0.js"></script>
    <script src="https://itinere.pro/js/Leaflet.MultiOptionsPolyline.min.js"></script>
    <script src="https://itinere.pro/js/d3.v5.min.js"></script>
    <script src="https://itinere.pro/js/leaflet-elevation.js"></script>
    <script src="https://itinere.pro/js/i18n.js" defer></script>
    <script src="https://itinere.pro/js/components.js" defer></script>

    <style>
        body { background: var(--c-canvas); overflow: hidden; }

        #mimapa {
            position: fixed; left: 0; right: 0;
            top: calc(var(--header-h) + var(--safe-top));
            bottom: 0;
            z-index: 1;
        }

        .live-stats {
            position: fixed; left: 0; right: 0;
            top: calc(var(--header-h) + var(--safe-top));
            display: grid; grid-template-columns: repeat(3, 1fr);
            gap: var(--sp-2);
            padding: var(--sp-3) var(--sp-4);
            background: linear-gradient(180deg, var(--c-canvas), transparent);
            z-index: 2;
            pointer-events: none;
        }
        .live-stat {
            background: var(--c-glass);
            backdrop-filter: blur(12px) saturate(180%);
            border-radius: var(--r-lg);
            padding: var(--sp-2) var(--sp-3);
            text-align: center;
            box-shadow: var(--shadow-sm);
        }
        .live-stat__value {
            font-family: var(--font-display);
            font-size: var(--fs-xl);
            font-weight: var(--fw-black);
            line-height: 1;
            color: var(--c-ink);
            font-variant-numeric: tabular-nums;
        }
        .live-stat__label {
            font-size: var(--fs-xs);
            color: var(--c-ink-muted);
            text-transform: uppercase;
            letter-spacing: .05em;
            margin-top: 2px;
        }

        /* Barra de progreso flotante sobre el mapa */
        .progress-pill {
            position: fixed;
            left: var(--sp-4); right: var(--sp-4);
            top: calc(var(--header-h) + var(--safe-top) + 100px);
            background: var(--c-glass);
            backdrop-filter: blur(12px);
            border-radius: var(--r-pill);
            padding: 8px var(--sp-3);
            display: flex; align-items: center; gap: var(--sp-3);
            z-index: 3;
            box-shadow: var(--shadow-sm);
            font-size: var(--fs-xs);
            color: var(--c-ink);
        }
        .progress-pill__bar {
            flex: 1;
            height: 6px;
            background: var(--c-border);
            border-radius: var(--r-pill);
            overflow: hidden;
        }
        .progress-pill__fill {
            height: 100%;
            width: 0%;
            background: var(--c-accent);
            transition: width 200ms;
        }
        .progress-pill__txt { font-weight: var(--fw-bold); font-variant-numeric: tabular-nums; }

        .gps-pin {
            position: fixed;
            top: calc(var(--header-h) + var(--safe-top) + 150px);
            right: var(--sp-4);
            z-index: 3;
        }

        .action-bar {
            position: fixed;
            left: 0; right: 0; bottom: 0;
            padding: var(--sp-4) var(--sp-4) calc(var(--safe-bottom) + var(--sp-4));
            display: grid;
            grid-template-columns: 56px 1fr 56px;
            gap: var(--sp-3);
            align-items: center;
            z-index: var(--z-sticky);
            background: linear-gradient(0deg, var(--c-canvas), transparent);
        }
        .action-bar .iconbtn {
            background: var(--c-surface);
            box-shadow: var(--shadow-md);
        }
        .action-bar .iconbtn[disabled] { opacity: .4; pointer-events: none; }
        .btn-recorrer {
            min-height: 64px;
            font-size: var(--fs-lg);
            border-radius: var(--r-pill);
            background: var(--c-accent);
            color: var(--c-on-accent);
            box-shadow: var(--shadow-accent);
            display: flex; align-items: center; justify-content: center;
            gap: var(--sp-2); font-family: var(--font-display); font-weight: var(--fw-black);
            transition: all var(--t-quick);
        }
        .btn-recorrer:active { transform: scale(.97); }
        .btn-recorrer[data-state="run"] {
            background: var(--c-danger);
            color: #fff;
            box-shadow: 0 8px 24px rgba(255, 23, 68, .45);
            animation: pulse 1.6s ease-in-out infinite;
        }
        .btn-recorrer[disabled] { opacity: .5; pointer-events: none; }
        @keyframes pulse {
            0%, 100% { box-shadow: 0 8px 24px rgba(255, 23, 68, .45); }
            50%      { box-shadow: 0 8px 32px rgba(255, 23, 68, .8); }
        }

        .details-sheet {
            position: fixed; left: 0; right: 0; bottom: 0;
            background: var(--c-surface);
            border-radius: var(--r-xl) var(--r-xl) 0 0;
            box-shadow: var(--shadow-lg);
            padding: var(--sp-3) var(--sp-5) calc(var(--safe-bottom) + 96px);
            z-index: var(--z-overlay);
            transform: translateY(calc(100% - 0px));
            transition: transform var(--t-slow);
            max-height: 80dvh; overflow-y: auto;
        }
        .details-sheet.is-open { transform: translateY(0); }
        .details-sheet__handle-wrap {
            height: 32px;
            display: flex; align-items: center; justify-content: center;
            cursor: pointer;
            margin: 0 0 var(--sp-2);
        }
        .details-sheet__handle {
            width: 48px; height: 5px;
            background: var(--c-border-strong);
            border-radius: var(--r-pill);
        }
        .details-sheet__close {
            position: absolute;
            top: 10px; right: 12px;
            width: 40px; height: 40px;
            background: var(--c-surface-2);
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            color: var(--c-ink);
            box-shadow: var(--shadow-sm);
            z-index: 1;
        }
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: var(--sp-3);
        }
        .section-block { margin-top: var(--sp-5); }
        .section-block h3 {
            font-size: var(--fs-sm); text-transform: uppercase;
            letter-spacing: .08em; color: var(--c-ink-muted);
            margin: 0 0 var(--sp-3); font-weight: var(--fw-bold);
        }

        .modal-sheet {
            position: fixed; inset: 0;
            background: var(--c-canvas);
            z-index: var(--z-modal);
            transform: translateX(100%);
            transition: transform var(--t-slow);
            display: flex; flex-direction: column;
        }
        .modal-sheet.is-open { transform: translateX(0); }
        .modal-sheet__head {
            padding: calc(var(--safe-top) + var(--sp-4)) var(--sp-4) var(--sp-4);
            display: flex; align-items: center; gap: var(--sp-3);
            border-bottom: 1px solid var(--c-border);
        }
        .modal-sheet__head h2 { margin: 0; font-size: var(--fs-lg); }
        .modal-sheet__body { flex: 1; overflow-y: auto; padding: var(--sp-4); }
        .modal-sheet__footer {
            padding: var(--sp-4) var(--sp-4) calc(var(--safe-bottom) + var(--sp-4));
            border-top: 1px solid var(--c-border);
            display: flex; gap: var(--sp-3);
            background: var(--c-surface);
        }
        .modal-sheet__footer .btn { flex: 1; }
        .switch-row {
            display: flex; align-items: center; justify-content: space-between;
            padding: var(--sp-3) 0; border-bottom: 1px solid var(--c-border);
        }
        .switch-row__label { color: var(--c-ink); font-size: var(--fs-md); }
        .switch-row__hint  { color: var(--c-ink-muted); font-size: var(--fs-sm); margin-top: 2px; }

        /* Modal "Ruta completada" */
        .finish-card {
            background: var(--c-surface);
            border-radius: var(--r-xl);
            padding: var(--sp-5);
            text-align: center;
            margin: var(--sp-4) auto;
            max-width: 420px;
            box-shadow: var(--shadow-lg);
        }
        .finish-card h1 {
            font-family: var(--font-display);
            font-size: var(--fs-xl);
            margin: 0 0 var(--sp-3);
        }
        .finish-card .finish-stats {
            display: grid; grid-template-columns: repeat(2, 1fr);
            gap: var(--sp-2);
            margin-top: var(--sp-4);
        }
        .finish-card .finish-stat {
            background: var(--c-surface-2);
            border-radius: var(--r-md);
            padding: var(--sp-3);
        }
        .finish-card .finish-stat__label { font-size: var(--fs-xs); color: var(--c-ink-muted); text-transform: uppercase; }
        .finish-card .finish-stat__value { font-size: var(--fs-lg); font-weight: var(--fw-bold); }

        /* Cámara */
        #divFoto { background: #000; }
        #tomarFoto {
            position: fixed; bottom: calc(var(--safe-bottom) + var(--sp-5));
            left: 50%; transform: translateX(-50%);
            width: 64px; height: 64px;
            background: var(--c-danger);
            border-radius: 50%; border: 4px solid #fff;
            z-index: 1000000002;
            box-shadow: 0 8px 24px rgba(0,0,0,.45);
        }
        .cam-close {
            position: fixed;
            top: calc(var(--safe-top) + var(--sp-3));
            left: var(--sp-3);
            width: 44px; height: 44px;
            background: rgba(0,0,0,.5);
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            color: #fff;
            z-index: 1000000002;
        }

        #bolsillo { background: #000; color: #fff; padding: var(--sp-5); }
        #bolsillo h1 { color: #fff; }

        .loading-overlay {
            position: fixed;
            top: calc(var(--header-h) + var(--safe-top));
            left: 0; right: 0; bottom: 0;
            background: var(--c-canvas);
            display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            gap: var(--sp-3);
            z-index: 4;
        }
        .loading-overlay .skeleton-bar {
            width: 200px; height: 4px;
            background: var(--c-border);
            border-radius: var(--r-pill);
            overflow: hidden;
        }
        #progreso { height: 100%; background: var(--c-accent); width: 0%; transition: width 200ms; }

        .alert-banner {
            position: fixed;
            top: calc(var(--safe-top) + var(--sp-2));
            left: var(--sp-3); right: var(--sp-3);
            background: var(--c-warning); color: #000;
            border-radius: var(--r-md);
            padding: var(--sp-3) var(--sp-4);
            z-index: 1000000018;
            box-shadow: var(--shadow-lg);
            display: none;
        }

        /* Perfil de elevación flotante */
        #elevation-wrap {
            position: fixed;
            left: 0; right: 0;
            bottom: calc(96px + var(--safe-bottom) + 40px);
            z-index: 2;
            background: rgba(255, 255, 255, .1);
            backdrop-filter: blur(10px) saturate(140%);
            border-top: 1px solid var(--c-border);
            border-bottom: 1px solid var(--c-border);
            height: 140px;
            overflow: hidden;
        }
        @media (prefers-color-scheme: dark) {
            #elevation-wrap { background: rgba(20, 23, 42, .92); }
        }
        /* En landscape de móvil reducimos la altura para no comerse el mapa */
        @media (orientation: landscape) and (max-height: 500px) {
            #elevation-wrap { height: 90px; }
            #elevation-wrap #elevation-div { height: 90px; }
        }
        #elevation-div {
            height: 140px;
            padding: var(--sp-2) var(--sp-3);
            overflow: hidden;
        }
        /* Override de leaflet-elevation para que el chart use todo el ancho */
        #elevation-div .elevation { width: 100% !important; }
        #elevation-div .elevation .background { fill: transparent; }
        @media (prefers-color-scheme: dark) {
            .alert-banner { background: var(--c-highlight); }
        }
    </style>
</head>
<body>

    <header class="appbar">
        <a href="/index.html" class="iconbtn" aria-label="Atrás">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </a>
        <span class="appbar__logo">
            <img src="/img/logo.svg" width="28" height="28" alt="">
            <span data-i18n="nav.ruta">Recorrer ruta</span>
        </span>
        <span class="appbar__spacer"></span>
        <button class="iconbtn" id="btn-avance-top" aria-label="Avance" data-i18n-aria-label="ruta.avance">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
        </button>
        <button class="iconbtn" id="btn-config" aria-label="Configuración">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        </button>
    </header>

    <div id="mimapa"></div>

    <!-- Stats en vivo sobre el mapa -->
    <div class="live-stats" aria-live="polite">
        <div class="live-stat">
            <div class="live-stat__value"><span id="velocidad">0</span></div>
            <div class="live-stat__label">km/h</div>
        </div>
        <div class="live-stat">
            <div class="live-stat__value"><span id="distancia">0</span></div>
            <div class="live-stat__label">m</div>
        </div>
        <div class="live-stat">
            <div class="live-stat__value"><span id="horas">00</span>:<span id="minutos">00</span>:<span id="segundos">00</span></div>
            <div class="live-stat__label" data-i18n="ruta.tiempo">tiempo</div>
        </div>
    </div>

    <!-- Barra de progreso -->
    <div class="progress-pill" id="progress-pill" style="display:none;">
        <span class="progress-pill__txt"><span id="porciento">0</span>%</span>
        <div class="progress-pill__bar"><div class="progress-pill__fill" id="recorrido"></div></div>
        <span class="progress-pill__txt"><span id="pendiente">0</span> m</span>
    </div>

    <itinere-gps-chip class="gps-pin" status="ok" id="gpsChip"></itinere-gps-chip>

    <!-- Avisos -->
    <div id="errorGeo" class="alert-banner">
        <strong data-i18n="errores.geo">Sin datos de ubicación.</strong>
        <div style="margin-top:var(--sp-2);display:flex;gap:var(--sp-2);">
            <button class="btn btn--ghost" style="min-height:40px;padding:0 var(--sp-3);" onclick="location.reload()" data-i18n="errores.retry">Reintentar</button>
        </div>
    </div>
    <div id="infoNo" class="alert-banner" data-i18n="errores.geoUnsupported">
        Tu navegador no soporta geolocalización.
    </div>
    <div id="lejos" class="alert-banner">
        <strong data-i18n="ruta.lejos">Estás lejos del inicio.</strong>
        <div style="margin-top:var(--sp-2);font-size:var(--fs-sm);">
            <span data-i18n="ruta.lejosHint">Acércate al punto de partida y reintentaremos automáticamente.</span>
        </div>
    </div>

    <!-- Carga inicial -->
    <div id="cargando" class="loading-overlay" style="display:inline;">
        <strong data-i18n="ruta.cargando">Localizando tu posición y cargando la ruta…</strong>
        <div class="skeleton-bar"><div id="progreso"></div></div>
    </div>

    <!-- Sheet de detalles (avance) -->
    <aside class="details-sheet" id="detailsSheet" aria-label="Detalles del avance">
        <button class="details-sheet__close" id="btn-close-details" aria-label="Cerrar">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
        <div class="details-sheet__handle-wrap" id="details-handle-wrap" aria-label="Arrastra o pulsa para cerrar">
            <div class="details-sheet__handle"></div>
        </div>
        <h2 style="font-size:var(--fs-lg);margin:0 0 var(--sp-4);" data-i18n="ruta.avance">Avance</h2>

        <div class="section-block">
            <div class="stats-grid">
                <div class="stat"><div class="stat__value text-num"><span id="marcha">00:00:00</span></div><div class="stat__label" data-i18n="ruta.marcha">marcha</div></div>
                <div class="stat"><div class="stat__value text-num"><span id="descanso">00:00:00</span></div><div class="stat__label" data-i18n="ruta.descanso">descanso</div></div>
                <div class="stat"><div class="stat__value text-num"><span id="distancia_2">0</span> m</div><div class="stat__label" data-i18n="ruta.recorrido">recorrido</div></div>
                <div class="stat"><div class="stat__value text-num"><span id="velocidad_2">0</span> km/h</div><div class="stat__label" data-i18n="ruta.velocidad">velocidad</div></div>
                <div class="stat"><div class="stat__value text-num"><span id="pendiente_2">0</span> m</div><div class="stat__label" data-i18n="ruta.faltan">faltan</div></div>
                <div class="stat"><div class="stat__value text-num"><span id="porciento_2">0</span>%</div><div class="stat__label" data-i18n="ruta.completado">completado</div></div>
            </div>
        </div>

        <div class="section-block">
            <h3 data-i18n="ruta.fotos">Fotos</h3>
            <div id="fotos"></div>
        </div>
    </aside>

    <!-- Perfil de elevación flotante (oculto hasta que la ruta cargue) -->
    <div id="elevation-wrap" style="display:none;" aria-label="Perfil de elevación">
        <div id="elevation-div" role="img" aria-label="Gráfico de elevación de la ruta"></div>
    </div>


    <!-- Action bar -->
    <div class="action-bar" id="botones">
        <button class="iconbtn" id="btFoto" onclick="verFoto()" aria-label="Foto" disabled>
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
        </button>

        <button class="btn-recorrer" id="boton" data-state="idle" onclick="inicio()" disabled>
            <span id="btn-recorrer-label" data-i18n="ruta.iniciar">Iniciar</span>
        </button>

        <button class="iconbtn" id="configuracion" onclick="herramientas()" aria-label="Configurar">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
    </div>

    <!-- Modal "Ruta completada" -->
    <section class="modal-sheet" id="sheet-completado" aria-label="Ruta completada">
        <header class="modal-sheet__head">
            <h2 data-i18n="ruta.completada">¡Ruta completada!</h2>
        </header>
        <div class="modal-sheet__body">
            <div class="finish-card">
                <h1>🎉 <span data-i18n="ruta.bien">¡Bien!</span></h1>
                <p class="muted" data-i18n="ruta.completadaHint">Hemos registrado tu actividad.</p>
                <div class="finish-stats">
                    <div class="finish-stat">
                        <div class="finish-stat__label" data-i18n="ruta.tiempo">tiempo</div>
                        <div class="finish-stat__value"><span id="tiempo">00:00:00</span></div>
                    </div>
                    <div class="finish-stat">
                        <div class="finish-stat__label" data-i18n="ruta.recorrido">recorrido</div>
                        <div class="finish-stat__value"><span id="distancia_f">0</span> m</div>
                    </div>
                    <div class="finish-stat">
                        <div class="finish-stat__label" data-i18n="ruta.marcha">marcha</div>
                        <div class="finish-stat__value"><span id="marcha_f">00:00:00</span></div>
                    </div>
                    <div class="finish-stat">
                        <div class="finish-stat__label" data-i18n="ruta.descanso">descanso</div>
                        <div class="finish-stat__value"><span id="descanso_f">00:00:00</span></div>
                    </div>
                    <div class="finish-stat">
                        <div class="finish-stat__label" data-i18n="ruta.velocidad">velocidad</div>
                        <div class="finish-stat__value"><span id="velocidad_f">0</span> km/h</div>
                    </div>
                    <div class="finish-stat">
                        <div class="finish-stat__label" data-i18n="ruta.velmax">vel. máx</div>
                        <div class="finish-stat__value"><span id="velmax_f">0</span> km/h</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-sheet__footer">
            <button class="btn" onclick="location.href='/index.html'" data-i18n="boton.cerrar">Cerrar</button>
        </div>
    </section>

    <!-- Modal configuración -->
    <section class="modal-sheet" id="sheet-config" aria-label="Configuración">
        <header class="modal-sheet__head">
            <button class="iconbtn" onclick="cerrarSheet('sheet-config')" aria-label="Cerrar">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
            <h2 data-i18n="ruta.config.titulo">Configuración</h2>
        </header>
        <div class="modal-sheet__body">
            <div class="switch-row">
                <div><div class="switch-row__label" data-i18n="ruta.config.full">Pantalla completa</div></div>
                <div class="switch"><input type="checkbox" onchange="maximiza()" id="maxi" class="toggle"><label for="maxi" class="slider"></label></div>
            </div>
            <div class="switch-row">
                <div>
                    <div class="switch-row__label" data-i18n="grabar.config.compartir">Compartir la ruta</div>
                    <div class="switch-row__hint" id="publicacion" style="display:none;">
                        <span data-i18n="grabar.config.urlPubli">URL de publicación:</span>
                        <input id="urlPubli" type="text" readonly value="" style="margin-top:var(--sp-2);">
                        <button id="btCopia" type="button" class="btn btn--ghost" style="min-height:40px;margin-top:var(--sp-2);" onclick="copiarpp()">Copiar</button>
                    </div>
                </div>
                <div class="switch"><input type="checkbox" onchange="comparte()" id="compartir" class="toggle"><label for="compartir" class="slider"></label></div>
            </div>
            <div class="switch-row">
                <div><div class="switch-row__label" data-i18n="ruta.config.alarmaGPS">Alarma pérdida GPS</div></div>
                <div class="switch"><input type="checkbox" checked onchange="alGPS()" id="gps" class="toggle"><label for="gps" class="slider"></label></div>
            </div>
            <div class="switch-row">
                <div><div class="switch-row__label" data-i18n="ruta.config.alarmaDesvio">Alarma de desvío</div></div>
                <div class="switch"><input type="checkbox" checked onchange="alDesvio()" id="btDesvio" class="toggle"><label for="btDesvio" class="slider"></label></div>
            </div>
            <div class="switch-row">
                <div>
                    <div class="switch-row__label" data-i18n="ruta.config.bolsillo">Modo bolsillo</div>
                    <div class="switch-row__hint" data-i18n="ruta.config.bolsilloHint">Pantalla negra para llevar el móvil sin desbloquearlo accidentalmente.</div>
                </div>
                <div class="switch"><input type="checkbox" onchange="bolsillo()" id="btBolsillo" class="toggle"><label for="btBolsillo" class="slider"></label></div>
            </div>
        </div>
        <div class="modal-sheet__footer">
            <button class="btn btn--ghost btn--full" onclick="herramientas()" data-i18n="boton.cerrar">Cerrar</button>
        </div>
    </section>

    <!-- Pantalla bolsillo -->
    <div id="bolsillo" style="position:fixed;inset:0;background:#000;display:none;z-index:1000001000;color:#fff;padding:var(--sp-5);overflow-y:auto;">
        <div id="bodrio">
            <h1 data-i18n="grabar.bolsillo.titulo">Modo Bolsillo</h1>
            <p data-i18n="grabar.bolsillo.texto">El modo bolsillo apaga la pantalla sin suspender el teléfono. Desliza desde el borde izquierdo para volver.</p>
            <div style="display:flex;gap:var(--sp-3);margin-top:var(--sp-5);">
                <button class="btn btn--full" onclick="document.getElementById('bodrio').style.display='none';" data-i18n="grabar.bolsillo.ok">Entendido</button>
                <button class="btn btn--ghost btn--full" onclick="document.getElementById('bolsillo').style.display='none';salirPantallaCompleta();" data-i18n="boton.cancelar">Cancelar</button>
            </div>
        </div>
    </div>

    <!-- Cámara -->
    <div id="divFoto" style="position:fixed;inset:0;background:#000;display:none;z-index:1000000050;">
        <canvas id="canvas" width="1280" height="720" style="display:none;"></canvas>
        <video id="video" style="position:fixed;inset:0;width:100%;height:100%;z-index:1000000001;"></video>
        <button class="cam-close" onclick="verFoto()" aria-label="Cerrar cámara">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
        <div id="tomarFoto"></div>
        <div id="comentarFoto" style="position:fixed;right:var(--sp-3);bottom:calc(var(--safe-bottom) + var(--sp-3));left:var(--sp-3);display:none;z-index:1000000002;">
            <input id="comentarioFoto" type="text" placeholder="Comentario" style="background:#fff;color:#000;">
            <button class="btn btn--full" style="margin-top:var(--sp-2);" onclick="publicaFoto()" data-i18n="grabar.foto.publicar">Publicar foto</button>
        </div>
    </div>

    <!-- Chat embebido (oculto hasta compartir) — mismo bloque que grabar-ruta.html -->
    <div id="chat-area" style="position:fixed;top:calc(var(--header-h) + var(--safe-top) + 130px);left:var(--sp-3);width:30px;height:30px;background:var(--c-glass);backdrop-filter:blur(12px);border-radius:var(--r-md);overflow:hidden;display:none;z-index:1000000012;border:1px solid var(--c-border);">
        <img id="imgChat" onclick="chatea()" src="https://itinere.pro/usuario.png" style="width:30px;height:30px;cursor:pointer;">
        <span id="nombreChat" style="margin:10px;color:var(--c-primary);font-size:var(--fs-lg);font-weight:bold;"></span>
        <iframe id="chat" src="" style="width:100%;height:50%;border:none;"></iframe>
    </div>

    <audio id="alerta"  src="https://itinere.pro/alerta.mp3" style="display:none;"></audio>
    <audio id="desvio"  src="https://itinere.pro/desvio.mp3" style="display:none;"></audio>

<script>
// ============================ Wrappers UI ============================
const sheetDetails = document.getElementById('detailsSheet');
document.getElementById('btn-avance-top').addEventListener('click', () => sheetDetails.classList.toggle('is-open'));
document.getElementById('btn-close-details').addEventListener('click', () => sheetDetails.classList.remove('is-open'));
document.getElementById('details-handle-wrap').addEventListener('click', () => sheetDetails.classList.toggle('is-open'));
document.getElementById('btn-config').addEventListener('click', () => abrirSheet('sheet-config'));
function abrirSheet(id)  { document.getElementById(id).classList.add('is-open'); }
function cerrarSheet(id) { document.getElementById(id).classList.remove('is-open'); }
function herramientas() {
    document.getElementById('sheet-config').classList.toggle('is-open');
}

// ============================ Estado ============================
const base = 'https://itinere.pro/';
let coordenadasInvertidas = [];   // ruta original [lat, lon]
let polylineOriginalBase  = null; // polyline rojo grueso de la ruta original
let polylineOriginalColor = null; // multiOptionsPolyline degradado
let polylineUsuario       = null; // polyline del recorrido del usuario actual
let puntosUsuario         = [];   // [[lat, lon], ...]
let degradado;
let indice    = 0;
let indiceDibujado = -1;
let contador  = 0;
let multiplo  = 0;
let malas     = 1;
let precis    = 10;
let errores   = 0;
let fallos    = 0;
let paros     = 0;
let marcha    = 0;
let segundos  = 0;
let parada    = false;
let graba     = false;
let alarmaGPS = true;
let alarmaDesvio = true;
let compartido = false;
let crono;
let grabando;
let latitud, longitud;
let ultimaPosicion = [];
let velocidad = 0;
let velmax    = 0;
let distanciaUsuario = 0;     // metros recorridos por el usuario
const totalRuta = parseFloat(dis);  // longitud total de la ruta original
let wakeLock = null;
let marker = [];
let markerInicio;
let markerActual;

// ============================ Helpers ============================
const marcainicio = L.icon({ iconUrl: base + 'images/pin-icon-start.png', iconSize: [22, 30] });
const marcador    = L.icon({ iconUrl: base + 'marcador.gif',              iconSize: [58, 58] });
const marcado     = L.icon({ iconUrl: base + 'puntocam.png',              iconSize: [35, 35] });

function calcularDistanciaEnMetros(lat1, lon1, lat2, lon2) {
    const R = 6371000;
    const dLat = (lat2 - lat1) * Math.PI / 180;
    const dLon = (lon2 - lon1) * Math.PI / 180;
    const a = Math.sin(dLat / 2) ** 2 +
              Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
              Math.sin(dLon / 2) ** 2;
    return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
}
function hexToRgb(hex) {
    const m = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
    return m ? [parseInt(m[1], 16), parseInt(m[2], 16), parseInt(m[3], 16)] : [0, 0, 0];
}
function rgbToHex(r, g, b) {
    return '#' + [r, g, b].map(x => x.toString(16).padStart(2, '0')).join('');
}
// Degradado naranja→rojo, pero los primeros `idx` puntos forzados a azul (ya recorridos)
function crearDegradado(c1, c2, pasos, idx) {
    const [r1, g1, b1] = hexToRgb(c1);
    const [r2, g2, b2] = hexToRgb(c2);
    const out = [];
    for (let i = 0; i <= pasos; i++) {
        if (i <= idx) {
            out.push({ color: '#2E27F5' });
        } else {
            const t = i / pasos;
            out.push({ color: rgbToHex(
                Math.round(r1 + t * (r2 - r1)),
                Math.round(g1 + t * (g2 - g1)),
                Math.round(b1 + t * (b2 - b1))
            ) });
        }
    }
    return out;
}
function fmtHHMMSS(secs) {
    const h = Math.floor(secs / 3600), m = Math.floor((secs % 3600) / 60), s = secs % 60;
    return String(h).padStart(2, '0') + ':' + String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
}
async function requestWakelock() {
    try { if ('wakeLock' in navigator) wakeLock = await navigator.wakeLock.request('screen'); }
    catch (e) { console.log('wakelock:', e); }
}
function releaseWakelock() {
    try { wakeLock?.release?.(); wakeLock = null; } catch (e) {}
}

// ============================ Mapa ============================
const mymap = L.map('mimapa', {
    center: [parseFloat(latIni), parseFloat(lonIni)],
    zoom: 16,
});
L.tileLayer('https://itinere.pro/mapbox/styles/v1/{id}/tiles/{z}/{x}/{y}?access_token=', {
    maxZoom: 20, noWrap: true, id: 'mapbox/outdoors-v12', attribution: 'Mapbox',
}).addTo(mymap);
markerInicio = L.marker([parseFloat(latIni), parseFloat(lonIni)], { icon: marcainicio }).addTo(mymap);

// ============================ Perfil de elevación ============================
// detachedView: el chart se pinta SÓLO en #elevation-div (fuera del control
// de Leaflet). El drag/brush sobre el chart hace fitBounds al tramo (lo
// gestiona la librería). IMPORTANTE: con detachedView se usa loadChart(map)
// en lugar de addTo(map), si no la librería crea dos containers (uno como
// control del mapa y otro en el elevationDiv) y se duplica al rotar.
const elevation = L.control.elevation({
    theme:              'magenta-theme',
    height:             120,
    margins:            { top: 10, right: 20, bottom: 30, left: 50 },
    useHeightIndicator: true,
    interpolation:      d3.curveLinear,
    collapsed:          false,
    detachedView:       true,
    responsiveView:     true,
    elevationDiv:       '#elevation-div',
    imperial:           false,
});

// ============================ Carga de la ruta original ============================
function cargarRutaOriginal() {
    return new Promise((resolve, reject) => {
        const s = document.createElement('script');
        s.src = base + 'rutas/' + ruta + '/ruta_' + ruta + '.js';
        s.onload = () => {
            try {
                const features = window.geojson?.features || [];
                let coords = [];
                features.forEach(f => {
                    if (f.geometry?.type === 'LineString') coords = f.geometry.coordinates; // [lng, lat, ele]
                });
                // [lng, lat, ...] → [lat, lon] para Leaflet
                coordenadasInvertidas = coords.map(c => [c[1], c[0]]);
                // Markers de fotos
                features.forEach(f => {
                    if (f.geometry?.type === 'Point') {
                        const [lng, lat] = f.geometry.coordinates;
                        L.marker([lat, lng], { icon: marcado })
                            .bindPopup(String(f.properties?.description || ''))
                            .addTo(mymap);
                    }
                });
                resolve();
            } catch (e) { reject(e); }
        };
        s.onerror = () => reject(new Error('No se pudo cargar la ruta'));
        document.head.appendChild(s);
    });
}

cargarRutaOriginal().then(() => {
    if (!coordenadasInvertidas.length) { console.warn('Ruta sin puntos'); return; }
    // Polyline de fondo (rojo gruesa) + multicolor degradado encima
    L.polyline(coordenadasInvertidas, { color: '#ff0000', weight: 10, opacity: .5 }).addTo(mymap);
    degradado = crearDegradado('#DBC207', '#F06700', coordenadasInvertidas.length, 0);
    polylineOriginalColor = L.multiOptionsPolyline(coordenadasInvertidas, {
        multiOptions: {
            optionIdxFn: (latLng, prev, idx) => Math.min(idx, degradado.length - 1),
            options: degradado,
        },
        weight: 6, opacity: 0.8, smoothFactor: 1,
    }).addTo(mymap);
    mymap.fitBounds(polylineOriginalColor.getBounds().pad(0.25));

    // 1. Mostrar el wrapper ANTES de cargar el chart: la librería lee
    //    offsetWidth del #elevation-div para dimensionar el SVG.
    document.getElementById('elevation-wrap').style.display = 'block';
    // 2. Pintar el chart en el elevationDiv (no como control del mapa).
    elevation.loadChart(mymap);
    // 3. Pasar el LineString. La línea NO se dibuja (opacity=0); las que se
    //    ven son las polylines del bloque anterior.
    L.geoJson(window.geojson, {
        filter: f => f.geometry?.type === 'LineString',
        style: { opacity: 0, weight: 0 },
        onEachFeature: elevation.addData.bind(elevation),
    }).addTo(mymap);
}).catch(err => console.error(err));

// ============================ Geolocalización ============================
function geo() {
    if (!('geolocation' in navigator)) {
        document.getElementById('infoNo').style.display = 'inline';
        return;
    }
    grabando = navigator.geolocation.watchPosition(success, errorGeo, {
        enableHighAccuracy: true, timeout: 10000, maximumAge: 0,
    });
}
function errorGeo(err) {
    if (errores > 2) {
        console.log('geo error:', err.message);
        if (contador === 0) document.getElementById('errorGeo').style.display = 'inline';
        else if (alarmaGPS) document.getElementById('alerta').play();
        errores = 0;
    } else {
        errores++; geo();
    }
}

function success(pos) {
    const crd = pos.coords;
    const precision = crd.accuracy;

    // Indicador GPS
    const chip = document.getElementById('gpsChip');
    if (precision <= 10)      chip.setAttribute('status', 'ok');
    else if (precision <= 30) chip.setAttribute('status', 'weak');
    else                      chip.setAttribute('status', 'none');

    if (precision > precis && malas < 5) { malas++; return; }
    if (malas >= 5) { fallos++; malas = 1; precis += 10; return; }
    malas = 1;
    if (contador === 0 && multiplo < 5) {
        multiplo++;
        document.getElementById('progreso').style.width = (multiplo * 20) + '%';
        return;
    }

    latitud  = crd.latitude;
    longitud = crd.longitude;

    // Oculta overlay de carga
    if (document.getElementById('cargando').style.display !== 'none') {
        document.getElementById('cargando').style.display = 'none';
    }

    // Compartir en vivo: emitir cada posición (esta página no mide altitud → 0)
    if (compartido == true) {
        ejecutarFuncionIframe('muevete', '${pos}' + longitud + '|' + latitud + '|' + 0 + '|' + velocidad);
    }

    // Aún no ha pulsado "Iniciar"
    if (!graba) {
        const dInicio = calcularDistanciaEnMetros(parseFloat(latIni), parseFloat(lonIni), latitud, longitud);
        if (dInicio > 100) {
            document.getElementById('lejos').style.display = 'inline';
            document.getElementById('boton').disabled = true;
        } else {
            document.getElementById('lejos').style.display = 'none';
            document.getElementById('boton').disabled = false;
            document.getElementById('btFoto').disabled = false;
        }
        return;
    }

    // Ya está recorriendo
    let dDelta = 0;
    if (ultimaPosicion.length === 2) {
        dDelta = calcularDistanciaEnMetros(ultimaPosicion[0], ultimaPosicion[1], latitud, longitud);
        if (dDelta < 1) {
            parada = true;
            document.getElementById('velocidad').innerHTML = '0';
            document.getElementById('velocidad_2').innerHTML = '0';
            return;
        } else {
            parada = false;
        }
    }
    distanciaUsuario += dDelta;

    // Marker actual del usuario
    if (markerActual) mymap.removeLayer(markerActual);
    markerActual = L.marker([latitud, longitud], { icon: marcador }).addTo(mymap);

    // Polyline del recorrido del usuario (se extiende sin recrear)
    puntosUsuario.push([latitud, longitud]);
    if (!polylineUsuario) {
        polylineUsuario = L.polyline(puntosUsuario, { color: '#22C55E', weight: 5, opacity: 0.9 }).addTo(mymap);
    } else {
        polylineUsuario.setLatLngs(puntosUsuario);
    }

    // Buscar el punto más cercano de la ruta original a partir del indice actual
    let medida = 0;
    for (let a = indice; a < coordenadasInvertidas.length; a++) {
        const d = calcularDistanciaEnMetros(latitud, longitud, coordenadasInvertidas[a][0], coordenadasInvertidas[a][1]);
        if (medida === 0) { medida = d; indice = a; }
        else {
            if (d <= medida) { medida = d; indice = a; }
            else break;
        }
    }

    if (medida < 100) {
        // Repinta la ruta original sólo si el indice cambió
        if (indice !== indiceDibujado) {
            if (polylineOriginalColor) polylineOriginalColor.remove();
            degradado = crearDegradado('#DBC207', '#F06700', coordenadasInvertidas.length, indice);
            polylineOriginalColor = L.multiOptionsPolyline(coordenadasInvertidas, {
                multiOptions: {
                    optionIdxFn: (latLng, prev, idx) => Math.min(idx, degradado.length - 1),
                    options: degradado,
                },
                weight: 6, opacity: 0.8, smoothFactor: 1,
            }).addTo(mymap);
            indiceDibujado = indice;
        }

        // Distancia recorrida según la ruta original (suma de segmentos hasta indice)
        let dRuta = 0;
        for (let a = 1; a <= indice; a++) {
            dRuta += calcularDistanciaEnMetros(
                coordenadasInvertidas[a - 1][0], coordenadasInvertidas[a - 1][1],
                coordenadasInvertidas[a][0],     coordenadasInvertidas[a][1]
            );
        }
        document.getElementById('distancia').innerHTML   = dRuta.toFixed(0);
        document.getElementById('distancia_2').innerHTML = dRuta.toFixed(0);

        velocidad = segundos > 0 ? (dRuta / 1000) * (3600 / segundos) : 0;
        if (velocidad > velmax) velmax = velocidad;
        document.getElementById('velocidad').innerHTML   = velocidad.toFixed(1);
        document.getElementById('velocidad_2').innerHTML = velocidad.toFixed(1);

        const pendiente = Math.max(0, totalRuta - dRuta);
        document.getElementById('pendiente').innerHTML   = pendiente.toFixed(0);
        document.getElementById('pendiente_2').innerHTML = pendiente.toFixed(0);

        const pct = totalRuta > 0 ? Math.min(100, Math.round((dRuta / totalRuta) * 100)) : 0;
        document.getElementById('porciento').innerHTML   = pct;
        document.getElementById('porciento_2').innerHTML = pct;
        document.getElementById('recorrido').style.width = pct + '%';
        document.getElementById('progress-pill').style.display = 'flex';

        if (indice >= coordenadasInvertidas.length - 1) {
            guarda();
        }
    } else if (alarmaDesvio) {
        document.getElementById('desvio').play();
    }

    ultimaPosicion[0] = latitud;
    ultimaPosicion[1] = longitud;
    contador++;
}

// ============================ Compartir en vivo (mismo flujo que grabar-ruta) ============================
function comparte() {
    if (!compartido) {
        // read-cookie es async: sin id todavía no hay canal ni URL válidos.
        if (!id) {
            document.getElementById('compartir').checked = false;
            alert('Esperando sesión — vuelve a intentarlo en unos segundos');
            return;
        }
        compartido = true;
        if (document.getElementById('imgChat').src == 'https://itinere.pro/usuario.png') {
            document.getElementById('imgChat').src = 'https://itinere.pro/usuarios/' + id + '/' + id + '.png';
        }
        document.getElementById('chat').src = 'https://itinere.pro:2083?/' + id + '/' + id;
        document.getElementById('chat-area').style.display = 'inline';
        document.getElementById('urlPubli').value = 'https://itinere.pro/go/' + id;
        document.getElementById('publicacion').style.display = 'block';
        obtenerUsuario(id);
    } else {
        compartido = false;
        document.getElementById('chat').src = '';
        document.getElementById('chat-area').style.display = 'none';
        document.getElementById('urlPubli').value = '';
        document.getElementById('publicacion').style.display = 'none';
    }
}

function copiarpp() {
    const t = document.getElementById('urlPubli').value;
    if (!t) return;
    navigator.clipboard.writeText(t).then(() => {
        document.getElementById('btCopia').textContent = '¡Copiado!';
        setTimeout(() => document.getElementById('btCopia').textContent = 'Copiar', 1000);
    });
}

function chatea() {
    const a = document.getElementById('chat-area');
    if (a.style.height == '30px') {
        a.style.height = '50%'; a.style.width = 'calc(100% - 40px)'; a.style.overflow = 'auto';
    } else {
        a.style.height = '30px'; a.style.width = '30px'; a.style.overflow = 'hidden';
    }
}

function ejecutarFuncionIframe(nombre, args) {
    document.getElementById('chat').contentWindow?.postMessage({ type: 'EJECUTAR_FUNCION', funcion: nombre, args }, 'https://itinere.pro:2083');
}

// Mensaje entrante del chat: si está minimizado, abrirlo.
window.addEventListener('message', e => {
    if (e.origin !== 'https://itinere.pro:2083') return;
    if (e.data?.tipo === 'ejecutarFuncion' && e.data.datos === 'mensaje') {
        if (document.getElementById('chat-area').style.height == '30px') chatea();
    }
});

async function obtenerUsuario(usuario) {
    try {
        const r = await fetch('https://itinere.pro/infoUsuario.php?id=' + usuario);
        if (!r.ok) throw new Error('HTTP ' + r.status);
        const j = await r.json();
        if (j.status === 'success') {
            j.data.forEach(d => document.getElementById('nombreChat').innerHTML = d.nombre);
        }
    } catch (e) { console.log(e); }
}

// ============================ Acción Iniciar/Detener ============================
function inicio() {
    const btn = document.getElementById('boton');
    const lbl = document.getElementById('btn-recorrer-label');
    if (btn.dataset.state !== 'run') {
        try { requestWakelock(); } catch (e) {}
        graba = true;
        btn.dataset.state = 'run';
        lbl.textContent = (window.Itinere?.t('ruta.detener')) || 'Detener';
        crono = setInterval(secundero, 1000);
    } else {
        try { releaseWakelock(); } catch (e) {}
        graba = false;
        clearInterval(crono);
        btn.dataset.state = 'idle';
        lbl.textContent = (window.Itinere?.t('ruta.seguir')) || 'Seguir';
    }
}

function secundero() {
    segundos++;
    if (!parada) {
        marcha = segundos - paros;
        document.getElementById('marcha').innerHTML = fmtHHMMSS(marcha);
    } else {
        paros = segundos - marcha;
        document.getElementById('descanso').innerHTML = fmtHHMMSS(paros);
    }
    // Reloj live-stats
    const total = segundos;
    document.getElementById('horas').innerHTML    = String(Math.floor(total / 3600)).padStart(2, '0');
    document.getElementById('minutos').innerHTML  = String(Math.floor((total % 3600) / 60)).padStart(2, '0');
    document.getElementById('segundos').innerHTML = String(total % 60).padStart(2, '0');
}

// ============================ Final: registrar actividad ============================
function guarda() {
    if (window._guardado) return;
    window._guardado = true;
    releaseWakelock();
    clearInterval(crono);
    graba = false;

    document.getElementById('tiempo').innerHTML      = fmtHHMMSS(segundos);
    document.getElementById('marcha_f').innerHTML    = document.getElementById('marcha').innerHTML;
    document.getElementById('descanso_f').innerHTML  = document.getElementById('descanso').innerHTML;
    document.getElementById('distancia_f').innerHTML = document.getElementById('distancia').innerHTML;
    document.getElementById('velocidad_f').innerHTML = document.getElementById('velocidad').innerHTML;
    document.getElementById('velmax_f').innerHTML    = velmax.toFixed(1);

    const formData = new FormData();
    formData.append('ruta',      ruta);
    formData.append('usuario',   id);
    formData.append('tiempo',    document.getElementById('tiempo').innerHTML);
    formData.append('distancia', document.getElementById('distancia_f').innerHTML);
    formData.append('velmedia',  document.getElementById('velocidad_f').innerHTML);
    formData.append('velmaxima', velmax.toFixed(2));
    formData.append('marcha',    document.getElementById('marcha_f').innerHTML);
    formData.append('descanso',  document.getElementById('descanso_f').innerHTML);

    fetch(base + 'index.php', { method: 'POST', body: formData, credentials: 'include' })
        .then(r => r.text())
        .then(data => {
            if (data.indexOf('ERROR:') === -1 && data.indexOf('error') === -1 && data.indexOf('Error') === -1) {
                abrirSheet('sheet-completado');
            } else {
                alert('No se pudo registrar la actividad: ' + data);
            }
        })
        .catch(err => alert('Error de red: ' + err));
}

// ============================ Configuración ============================
function alGPS()     { alarmaGPS    = document.getElementById('gps').checked; }
function alDesvio()  { alarmaDesvio = document.getElementById('btDesvio').checked; }
function maximiza() {
    if (document.getElementById('maxi').checked) {
        const el = document.documentElement;
        (el.requestFullscreen || el.webkitRequestFullscreen || el.mozRequestFullScreen)?.call(el);
    } else {
        salirPantallaCompleta();
    }
}
function salirPantallaCompleta() {
    if (document.fullscreenElement)        document.exitFullscreen?.();
    else if (document.webkitFullscreenElement) document.webkitExitFullscreen?.();
}
function bolsillo() {
    const b = document.getElementById('bolsillo');
    b.style.display = b.style.display === 'inline' ? 'none' : 'inline';
}

// Deslizar desde el borde izquierdo para salir del modo bolsillo
let startX, startY;
document.addEventListener('touchstart', e => { startX = e.touches[0].clientX; startY = e.touches[0].clientY; });
document.addEventListener('touchend', e => {
    const diffX = e.changedTouches[0].clientX - startX;
    const diffY = e.changedTouches[0].clientY - startY;
    if (Math.abs(diffX) > Math.abs(diffY) && diffX > 0) {
        if (document.getElementById('bolsillo').style.display === 'inline') {
            document.getElementById('bolsillo').style.display = 'none';
            document.getElementById('maxi').checked = false;
            document.getElementById('btBolsillo').checked = false;
            salirPantallaCompleta();
        }
    }
});

// ============================ Cámara ============================
let stream = null, fotosTomadas = 0, arrFotos = [], markerF = [];
async function verFoto() {
    const div = document.getElementById('divFoto');
    if (div.style.display === 'block') {
        try { stream?.getTracks?.().forEach(t => t.stop()); } catch (e) {}
        div.style.display = 'none';
        return;
    }
    try {
        stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } });
        const v = document.getElementById('video');
        v.srcObject = stream;
        v.play();
        div.style.display = 'block';
        document.getElementById('tomarFoto').style.display = 'inline-block';
        document.getElementById('comentarFoto').style.display = 'none';
    } catch (e) { alert('Sin acceso a la cámara'); }
}
document.getElementById('tomarFoto').addEventListener('click', () => {
    const v = document.getElementById('video');
    const c = document.getElementById('canvas');
    v.pause();
    c.width = v.videoWidth; c.height = v.videoHeight;
    c.getContext('2d').drawImage(v, 0, 0, c.width, c.height);
    try { stream?.getTracks?.().forEach(t => t.stop()); } catch (e) {}
    document.getElementById('tomarFoto').style.display = 'none';
    document.getElementById('comentarFoto').style.display = 'inline';
});
function publicaFoto() {
    document.getElementById('video').srcObject = null;
    document.getElementById('comentarFoto').style.display = 'none';
    document.getElementById('divFoto').style.display = 'none';
    const c = document.getElementById('canvas');
    const imgData = c.toDataURL('image/png', 0.6);
    const comentario = document.getElementById('comentarioFoto').value;
    const fotos = document.getElementById('fotos');
    fotos.innerHTML += `<div style="margin-top:var(--sp-3);text-align:center;">
        <img id="foto_${fotosTomadas}" src="${imgData}" style="max-width:100%;border-radius:var(--r-md);border:1px solid var(--c-border);">
        <p class="text-sm soft" style="margin-top:var(--sp-1);">${comentario}</p>
    </div>`;
    markerF[fotosTomadas] = L.marker([latitud, longitud], { icon: marcado }).addTo(mymap);
    markerF[fotosTomadas].bindPopup(`<img src="${imgData}" style="height:100px;">${comentario}`);
    arrFotos.push(longitud, latitud, comentario);
    fotosTomadas++;
}

// ============================ Arranque ============================
geo();
</script>
</body>
</html>
